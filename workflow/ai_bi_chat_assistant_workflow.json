{
  "name": "AI BI Chat Assistant Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-chat",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -200,
        0
      ],
      "id": "webhook-ai-chat-001",
      "name": "Webhook AI Chat",
      "credentials": {
        "httpHeaderAuth": {
          "id": "stackApiKeyHeaderAuth",
          "name": "Stack API Key Header Auth"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "=You are an expert AI Business Intelligence Assistant.\n\nUser ID: {{ $json.body.userId }}\nUser Name: {{ $json.body.userName }}\nUser Email: {{ $json.body.userEmail }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        200,
        0
      ],
      "id": "agent-ai-bi-001",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "deepseek.v3.2",
        "options": {
          "temperature": 0.1
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        200,
        200
      ],
      "id": "model-openai-proxy-001",
      "name": "OpenAI Proxy Model",
      "credentials": {
        "openAiApi": {
          "id": "proxy-cred-001",
          "name": "Enterprise AI Proxy Account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"reply\": {{ JSON.stringify($json.output) }},\n  \"success\": true\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        600,
        0
      ],
      "id": "respond-webhook-001",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook AI Chat": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Proxy Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}
