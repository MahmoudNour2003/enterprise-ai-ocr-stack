        "jsCode": "// Attach original binary file from Webhook to ensure HTTP Request node receives the binary file\nconst webhookBinary = $('Webhook').first().binary ? $('Webhook').first().binary.file : undefined;\nreturn [\n  {\n    json: $json,\n    binary: webhookBinary ? { file: webhookBinary } : {}\n  }\n];"
