# ==============================================================================
# Enterprise AI OCR & BI Stack - Environment Configuration
# ==============================================================================

# 1. VM & Domain Configuration
VM_PUBLIC_IP=127.0.0.1
WEBHOOK_URL=http://localhost:5678

# 2. Enterprise AI Proxy Configuration (Port 8000)
ITI_API_KEY=your_actual_iti_api_key_token_here
ITI_BASE_URL=http://apiaccess.iti.net.eg/api/v1
PORT=8000
MAX_RETRIES=3
ALLOWED_MODELS=openai.gpt-oss-120b-1:0,deepseek.v3.2

# 3. SQL MCP Server Configuration (Port 3001)
MCP_PORT=3001
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=SPIP_DB
DB_USER=AI_CHAT
DB_PASSWORD=AI@123
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# 4. PaddleOCR Service Configuration (Port 8080)
OCR_PORT=8080

# 5. n8n Engine Configuration (Port 5678)
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=supersecretn8nkey12345
